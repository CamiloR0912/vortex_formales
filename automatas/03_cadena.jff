<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>fa</type>
	<automaton>
		<state id="0" name="q0">
			<x>80.0</x>
			<y>150.0</y>
			<label>inicio</label>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>300.0</x>
			<y>150.0</y>
			<label>dentro de la cadena</label>
		</state>
		<state id="2" name="q2">
			<x>300.0</x>
			<y>340.0</y>
			<label>leído \ : el siguiente carácter va literal</label>
		</state>
		<state id="3" name="q3">
			<x>540.0</x>
			<y>150.0</y>
			<label>STRING_LIT (comilla de cierre)</label>
			<final/>
		</state>
		<transition>
			<from>0</from>
			<to>1</to>
			<read>"</read>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>#</read>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>\</read>
		</transition>
		<transition>
			<from>2</from>
			<to>1</to>
			<read>"</read>
		</transition>
		<transition>
			<from>2</from>
			<to>1</to>
			<read>\</read>
		</transition>
		<transition>
			<from>2</from>
			<to>1</to>
			<read>#</read>
		</transition>
		<transition>
			<from>1</from>
			<to>3</to>
			<read>"</read>
		</transition>
		<note>
			<text>QUÉ RECONOCE: texto entre comillas dobles, con escapes \" y \\
EXPRESIÓN REGULAR: \"([^"\\\n]|\\.)*\"
SÍMBOLOS: " = comilla    \ = barra invertida    # = cualquier otro carácter
ACEPTA: "hola" -&gt; "####"    "di \"si\"" -&gt; "###\"##\""
RECHAZA: "hola -&gt; "#### (sin comilla de cierre: unterminated string)
Un salto de línea dentro de la cadena no tiene transición: también es error.</text>
			<x>60.0</x>
			<y>440.0</y>
		</note>
	</automaton>
</structure>
