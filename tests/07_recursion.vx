// Recursión: Fibonacci, máximo común divisor, potencias y torres de Hanoi

func int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

func int gcd(int a, int b) {
    if (b == 0) { return a; }
    return gcd(b, a % b);
}

func float power(float base, int exp) {
    if (exp == 0) { return 1.0; }
    if (exp < 0) { return 1.0 / power(base, -exp); }
    return base * power(base, exp - 1);
}

func int hanoi(int disks) {
    if (disks == 0) { return 0; }
    return 2 * hanoi(disks - 1) + 1;          // movimientos necesarios
}

for (int i = 0; i <= 10; i = i + 1) {
    print("fib(", i, ") =", fib(i));
}
print("gcd(84, 36) =", gcd(84, 36));
print("2^10 =", power(2.0, 10));
print("2^-2 =", power(2.0, -2));
print("hanoi(5) =", hanoi(5), "moves");
