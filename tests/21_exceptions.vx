// try-catch, throw y assert

// ---- Un error de ejecución se atrapa y el programa continúa ----
try {
    int a = 10;
    int b = 0;
    print("before the error");
    print(a / b);
    print("never printed");
} catch (e) {
    print("caught:", e);
}

// ---- El error ocurre dentro de una función: el catch lo atrapa igual ----
func int get(vector<int> v, int i) { return v[i]; }
try {
    print(get([1, 2, 3], 7));
} catch (e) {
    print("caught:", e);
}

// ---- assert con mensaje y sin mensaje ----
func float half_positive(float x) {
    assert(x >= 0, "x must be non-negative, got " + x);
    return x / 2;
}
try {
    print(half_positive(8.0));
    print(half_positive(-4));
} catch (err) {
    print("caught:", err);
}
try {
    assert(1 + 1 == 3);
} catch (e) {
    print("caught:", e);
}

// ---- throw definido por el usuario ----
func float divide(float a, float b) {
    if (b == 0) { throw "cannot divide " + a + " by zero"; }
    return a / b;
}
try {
    print(divide(1, 4));
    print(divide(1, 0));
} catch (e) {
    print("caught:", e);
}

// ---- try anidado: el catch interno relanza y el externo lo atrapa ----
try {
    try {
        throw "inner problem";
    } catch (e) {
        print("inner caught:", e);
        throw "rethrown -> " + e;
    }
} catch (e) {
    print("outer caught:", e);
}

// ---- try dentro de un ciclo, con continue en el catch ----
vector<int> divisors = [2, 0, 5, 0, 10];
int ok = 0;
for (int i = 0; i < len(divisors); i = i + 1) {
    try {
        int r = 100 / divisors[i];
        ok = ok + 1;
    } catch (e) {
        print("  skip index", i, "->", e);
        continue;
    }
    print("  100 /", divisors[i], "=", 100 / divisors[i]);
}
print("ok divisions:", ok);

// ---- La recursión infinita se atrapa y el intérprete sigue sano ----
func int forever(int n) { return forever(n + 1); }
func int fact(int n) { if (n <= 1) { return 1; } return n * fact(n - 1); }
try {
    forever(0);
} catch (e) {
    print("caught:", e);
}
print("fact(6) after recovering =", fact(6));

// ---- return desde dentro de un try ----
func string classify(int n) {
    try {
        assert(n != 0, "zero has no sign");
        if (n > 0) { return "positive"; }
        return "negative";
    } catch (e) {
        return "error: " + e;
    }
}
print(classify(5), "|", classify(-2), "|", classify(0));
