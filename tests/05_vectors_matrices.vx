// Vectores y matrices: declaración, indexación, reducciones, aritmética elemento a elemento

// ---- Declaración con tipo explícito ----
vector<int> v = [3, 1, 4, 1, 5];
vector<float> w = [1, 2.5, 4];              // los int se convierten a float
vector<string> names = ["ana", "luis"];
vector<bool> flags = [true, false];
matrix<int> m = [[1, 2, 3], [4, 5, 6]];
matrix<float> id = [[1, 0], [0, 1]];
vector<int> empty = [];
print(v);
print(w);
print(names, flags);
print(m);
print(id);
print(empty);

// ---- Indexación y len ----
print("v[2] =", v[2], "| m[1][2] =", m[1][2], "| m[0] =", m[0]);
print("len(v) =", len(v), "| rows =", len(m), "| cols =", len(m[0]), "| len(\"hola\") =", len("hola"));

// ---- Asignación por índice (modifica en el lugar) ----
v[0] = 9;
m[1][1] = 50;
m[0] = [7, 8, 9];
print(v, m);

// ---- Reducciones ----
print("sum(v) =", sum(v), "| prod(v) =", prod(v), "| max(v) =", max(v), "| min(v) =", min(v));
print("sum(m) =", sum(m), "| max(m) =", max(m), "| min(m) =", min(m));
print("sum(w) =", sum(w), "| sum([]) =", sum(empty), "| prod([]) =", prod(empty));

// ---- Reducciones dentro de expresiones: precedencia y anidamiento ----
print(sum(v) * 2 + max(m) % 7);             // 40 + 50 % 7 = 41
print(-v[0] + v[1] * (v[2] - 1));           // -(v[0]) + 1 * 3 = -6
print(max([sum(v), prod([1, 2, 3]), len(names) * 10]));
print((sum(v) > 10 && min(v) == 1) || false);

// ---- Aritmética elemento a elemento ----
print(v * 2);
print(v + v);
print(w / 2);
print(m * 10 - 1);
print(-w);

// ---- Comparación ----
print([1, 2] == [1, 2], m == m, [1, 2] != [1, 2, 3]);

// ---- Asignar copia, no crea un alias ----
vector<int> copy = v;
copy[0] = -1;
print("v[0] =", v[0], "| copy[0] =", copy[0]);

// ---- Pasar a una función también copia ----
func void zero_first(vector<int> xs) {
    xs[0] = 0;
    print("  inside:", xs);
}
zero_first(v);
print("  outside:", v);

// ---- Funciones con vectores y matrices ----
func float mean(vector<float> xs) { return sum(xs) / len(xs); }
func float dot(vector<float> a, vector<float> b) { return sum(a * b); }
func vector<float> normalize(vector<float> xs) { return xs / max(xs); }
func matrix<int> transpose(matrix<int> a) {
    matrix<int> t = [[0, 0], [0, 0], [0, 0]];
    for (int i = 0; i < len(a); i = i + 1) {
        for (int j = 0; j < len(a[0]); j = j + 1) {
            t[j][i] = a[i][j];
        }
    }
    return t;
}
print("mean =", mean([1, 2, 3, 4]));        // vector<int> se promueve a vector<float>
print("dot =", dot([1, 2, 3], [4, 5, 6]));
print("normalize =", normalize(w));
print("transpose =", transpose(m));

// ---- Sobrecarga por tipo compuesto ----
func string kind(vector<int> x)    { return "vector<int>"; }
func string kind(vector<string> x) { return "vector<string>"; }
func string kind(matrix<int> x)    { return "matrix<int>"; }
print(kind(v), kind(names), kind(m));

// ---- Algoritmo completo: ordenamiento burbuja en el lugar ----
vector<int> data = [5, 2, 8, 1, 9, 3];
for (int i = 0; i < len(data); i = i + 1) {
    for (int j = 0; j < len(data) - 1 - i; j = j + 1) {
        if (data[j] > data[j + 1]) {
            int tmp = data[j];
            data[j] = data[j + 1];
            data[j + 1] = tmp;
        }
    }
}
print("sorted:", data);
