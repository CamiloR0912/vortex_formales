// Estructuras de control mal escritas
int x = 4;
while x < 10 { x = x + 1; }             // condición sin paréntesis
if (x == 4) print(x);                   // cuerpo sin llaves
for (int i = 0, i < 3, i = i + 1) { }   // comas en lugar de ';'
if (x = 4) { print("four"); }           // '=' en lugar de '=='
switch (x) {
    case 1 { print("one"); }            // falta ':' en el case
}
print("end");
