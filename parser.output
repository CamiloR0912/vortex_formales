Grammar

    0 $accept: program $end

    1 program: stmt_list

    2 stmt_list: ε
    3          | stmt_list stmt

    4 stmt: var_decl
    5     | simple_stmt ';'
    6     | block
    7     | if_stmt
    8     | while_stmt
    9     | for_stmt
   10     | switch_stmt
   11     | func_def
   12     | try_stmt
   13     | jump_stmt
   14     | assert_stmt
   15     | print_stmt
   16     | invalid_stmt
   17     | error ';'
   18     | error block

   19 block: '{' stmt_list '}'

   20 basic_type: "int"
   21           | "float"
   22           | "bool"
   23           | "string"

   24 type: basic_type
   25     | "vector" '<' basic_type '>'
   26     | "matrix" '<' basic_type '>'

   27 var_decl: type "identifier" '=' expr ';'
   28         | type "identifier" ';'
   29         | "vector" "identifier" '=' expr ';'
   30         | "matrix" "identifier" '=' expr ';'

   31 simple_stmt: expr
   32            | expr '=' expr

   33 condition: '(' expr ')'
   34          | '(' expr '=' expr ')'
   35          | '(' error ')'

   36 if_stmt: "if" condition block
   37        | "if" condition block "else" block
   38        | "if" condition block "else" if_stmt

   39 $@1: ε

   40 if_stmt: "if" error $@1 block
   41        | "if" condition error ';'
   42        | "if" condition block "else" error ';'

   43 while_stmt: "while" condition block

   44 $@2: ε

   45 while_stmt: "while" error $@2 block
   46           | "while" condition error ';'

   47 for_stmt: "for" '(' for_header ')' block

   48 $@3: ε

   49 for_stmt: "for" '(' error ')' $@3 block
   50         | "for" '(' for_header ')' error ';'

   51 for_header: for_init ';' expr_opt ';' for_step

   52 for_init: ε
   53         | type "identifier" '=' expr
   54         | simple_stmt

   55 for_step: ε
   56         | simple_stmt

   57 expr_opt: ε
   58         | expr

   59 switch_stmt: "switch" condition '{' case_list default_opt '}'
   60            | "switch" condition '{' case_list default_opt switch_error '}'

   61 switch_error: error block
   62             | error ';'
   63             | switch_error "case" expr ':' block
   64             | switch_error "default" ':' block

   65 case_list: ε
   66          | case_list "case" expr ':' block

   67 default_opt: ε
   68            | "default" ':' block

   69 func_def: "func" return_type "identifier" '(' params_opt ')' block
   70         | "func" return_type "identifier" '(' params_opt ')' ';'

   71 return_type: type
   72            | "void"

   73 params_opt: ε
   74           | param_list

   75 param_list: param
   76           | param_list ',' param

   77 param: type "identifier"
   78      | type "identifier" '=' expr

   79 try_stmt: "try" block "catch" '(' "identifier" ')' block
   80         | "try" block

   81 assert_stmt: "assert" '(' expr ')' ';'
   82            | "assert" '(' expr ',' expr ')' ';'
   83            | "assert" '(' ')' ';'

   84 jump_stmt: "return" ';'
   85          | "return" expr ';'
   86          | "break" ';'
   87          | "continue" ';'
   88          | "throw" expr ';'

   89 print_stmt: "print" '(' expr_list_opt ')' ';'

   90 invalid_stmt: "else" block
   91             | "else" if_stmt
   92             | "case" expr ':' block
   93             | "default" ':' block
   94             | "catch" '(' "identifier" ')' block

   95 expr: or_expr

   96 or_expr: and_expr
   97        | or_expr "||" and_expr

   98 and_expr: eq_expr
   99         | and_expr "&&" eq_expr

  100 eq_expr: rel_expr
  101        | eq_expr "==" rel_expr
  102        | eq_expr "!=" rel_expr

  103 rel_expr: add_expr
  104         | rel_expr '<' add_expr
  105         | rel_expr '>' add_expr
  106         | rel_expr "<=" add_expr
  107         | rel_expr ">=" add_expr

  108 add_expr: mul_expr
  109         | add_expr '+' mul_expr
  110         | add_expr '-' mul_expr

  111 mul_expr: unary
  112         | mul_expr '*' unary
  113         | mul_expr '/' unary
  114         | mul_expr '%' unary

  115 unary: postfix
  116      | '-' unary
  117      | '!' unary

  118 postfix: primary
  119        | postfix '[' expr ']'

  120 primary: "integer literal"
  121        | "float literal"
  122        | "string literal"
  123        | "boolean literal"
  124        | "identifier"
  125        | "identifier" '(' args_opt ')'
  126        | reduction '(' expr ')'
  127        | '(' expr ')'
  128        | '[' ']'
  129        | '[' expr_list ']'

  130 reduction: "sum"
  131          | "prod"
  132          | "max"
  133          | "min"
  134          | "len"

  135 expr_list_opt: ε
  136              | expr_list

  137 expr_list: expr
  138          | expr_list ',' expr

  139 args_opt: ε
  140         | arg_list

  141 arg_list: arg
  142         | arg_list ',' arg

  143 arg: expr
  144    | "identifier" '=' expr


